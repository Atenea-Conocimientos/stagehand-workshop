# API Keys para Stagehand
# Copia este archivo a .env y completa tus keys

# OpenAI (requerido si usas modelos de OpenAI)
OPENAI_API_KEY=sk-...

# Anthropic (requerido si usas modelos de Anthropic/Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Browserbase (opcional - solo si usas env: "BROWSERBASE")
BROWSERBASE_API_KEY=...
BROWSERBASE_PROJECT_ID=...
